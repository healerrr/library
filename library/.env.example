# 应用入口。若前面还有 Nginx/Caddy，建议将 APP_BIND 改为 127.0.0.1。
APP_BIND=0.0.0.0
APP_PORT=3000

# PostgreSQL。deploy.sh 会在首次运行时自动生成随机密码。
POSTGRES_DB=copyguard
POSTGRES_USER=copyguard
POSTGRES_PASSWORD=change-this-to-a-long-random-password

# 留空时由容器根据上面的 PostgreSQL 配置安全生成连接串。
# 使用外部数据库时可填写完整的 SQLAlchemy asyncpg URL。
DATABASE_URL=

# 中文语义向量模型。首次部署会下载并缓存模型，请保证服务器可访问模型源。
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
PRELOAD_EMBEDDING_MODEL=true

# 相似度权重（两项相加必须为 1）
SIMILARITY_LEXICAL_WEIGHT=0.45
SIMILARITY_SEMANTIC_WEIGHT=0.55
SIMILARITY_CHEMICAL_DISCOUNT=0.70
SIMILARITY_MIN_SCORE=0.60
SIMILARITY_CANDIDATE_LIMIT=200

# 采集限制
CRAWLER_MAX_PAGES=100
CRAWLER_TIMEOUT_SECONDS=15
CRAWLER_USER_AGENT=CopyGuardBot/1.0 (+https://your-company.example/bot)

# 仅在绕过前端代理、直接访问后端 API 时需要配置。
CORS_ORIGINS=http://localhost:3000
