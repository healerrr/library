# PostgreSQL（请在生产环境修改密码）
POSTGRES_DB=copyguard
POSTGRES_USER=copyguard
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://copyguard:change-me@db:5432/copyguard
BACKEND_PORT=8001

# 向量模型。首次使用 fastembed 时会下载约 100MB 的中文模型。
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSION=512
FASTEMBED_CACHE_PATH=/models

# 相似度权重（两项相加应为 1）
SIMILARITY_LEXICAL_WEIGHT=0.45
SIMILARITY_SEMANTIC_WEIGHT=0.55
SIMILARITY_CHEMICAL_DISCOUNT=0.70
SIMILARITY_MIN_SCORE=0.60
SIMILARITY_CANDIDATE_LIMIT=200

# 采集限制
CRAWLER_MAX_PAGES=100
CRAWLER_TIMEOUT_SECONDS=15
CRAWLER_USER_AGENT=CopyGuardBot/1.0 (+https://your-company.example/bot)

# 本地前端地址，多个地址用逗号分隔
CORS_ORIGINS=http://localhost:3000
NUXT_PUBLIC_API_BASE=http://localhost:8001/api
